# Скопируйте в .env.local (cp .env.example .env.local). Пустые значения = работа на mock-данных.
# Сюда ключи НЕ вписывать — этот файл попадает в git.

# LLM: разбор обращений и текст ответа. Цепочка Groq → Gemini → правила (без ключей работают правила)
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-120b

# Gemini (запасной): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite   # цепочка: при исчерпании квоты — следующая

# МойСклад JSON API 1.2 — Bearer-токен
MOYSKLAD_TOKEN=

# СДЭК API v2 — OAuth client credentials
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# CDEK_API_URL=https://api.edu.cdek.ru/v2   # тестовый контур

# Telegram-бот: создайте у @BotFather и вставьте токен. Пусто = бот выключен
TELEGRAM_BOT_TOKEN=

# Публичный адрес для QR на /live (необязательно: туннель определяется сам)
# PUBLIC_URL=https://support.example.kz
